{
  "name": "@quick-release/gq-ops",
  "version": "0.1.0",
  "description": "Interactive CLI for managing Ploi and inspecting Cloudflare projects",
  "type": "module",
  "bin": {
    "gq": "bin/gq.mjs"
  },
  "files": [
    "bin",
    "src",
    "docs/research/ploi-api.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "pnpm format:check && pnpm lint && pnpm test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "node --test"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.13.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Quick-Release/gq-ops.git"
  },
  "keywords": [
    "cloudflare",
    "ploi",
    "cli",
    "operations"
  ],
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.0.3",
    "globals": "^17.4.0",
    "prettier": "^3.8.2"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1"
  }
}
